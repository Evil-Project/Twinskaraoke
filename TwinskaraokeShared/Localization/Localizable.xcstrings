          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres importés via Twins Karaoke apparaîtront ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
