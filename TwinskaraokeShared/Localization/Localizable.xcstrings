    "Pick a song from Home, Search, or your Library to start." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Song unter Startseite, Suche oder in deiner Mediathek, um loszulegen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aloita valitsemalla kappale Kodista, Hausta tai kirjastostasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un titre dans Accueil, Recherche ou votre bibliothèque pour commencer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム、検索、ライブラリから曲を選んで始めましょう。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб почати, виберіть пісню на головній, у пошуку або в медіатеці."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从“首页”、“搜索”或你的资料库中选择一首歌曲开始。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從「首頁」、「搜尋」或你的資料庫中選擇一首歌曲開始。"
          }
        }
      }
    },
