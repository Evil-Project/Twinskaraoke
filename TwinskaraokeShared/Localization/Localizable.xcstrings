    "Pull down or tap retry when the video service is slow." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe nach unten oder tippe auf „Erneut versuchen“, wenn der Videodienst langsam ist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä alas tai napauta Yritä uudelleen, jos videopalvelu on hidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez vers le bas ou touchez Réessayer si le service vidéo est lent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ビデオサービスが遅いときは、下に引くか再試行をタップしてください。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потягніть униз або торкніться «Повторити», якщо відеосервіс працює повільно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频服务较慢时，请下拉或轻点重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片服務較慢時，請下拉或點一下重試。"
          }
        }
      }
    },
    "Pull down to refresh browse categories." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Aktualisieren der Kategorien nach unten ziehen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Päivitä selauskategoriat vetämällä alas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tirez vers le bas pour actualiser les catégories."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下に引いてカテゴリを更新します。"
