    "Real-time mode: audio is processed on-the-fly when you activate an audio effect. Only the unplayed portion is processed for faster results." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echtzeitmodus: Audio wird beim Aktivieren eines Audioeffekts direkt verarbeitet. Nur der noch nicht gespielte Teil wird verarbeitet, damit es schneller geht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Real-time mode: audio is processed on-the-fly when you activate an audio effect. Only the unplayed portion is processed for faster results."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reaaliaikatila: ääni käsitellään lennossa, kun otat äänitehosteen käyttöön. Vain toistamaton osa käsitellään, jotta tulos valmistuu nopeammin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mode temps réel : l’audio est traité à la volée lorsque vous activez un effet audio. Seule la partie non lue est traitée pour aller plus vite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイムモード：オーディオエフェクトを有効にすると、音声がその場で処理されます。未再生の部分だけを処理するため、すばやく反映されます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Режим реального часу: аудіо обробляється на льоту, коли ви вмикаєте аудіоефект. Обробляється лише невідтворена частина, щоб результат був швидшим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "实时模式：当您开启卡拉OK功能时，音频将被实时处理。系统仅处理未播放的部分，以提供更快的响应速度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即時模式：當您開啟卡拉OK功能時，音訊將被即時處理。系統僅處理未播放的部分，以提供更快的回應速度。"
          }
        }
      }
    },
