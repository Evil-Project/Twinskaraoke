      }
    },
    "The artist could not be loaded right now." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Künstler konnte gerade nicht geladen werden."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artistia ei voitu ladata juuri nyt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
