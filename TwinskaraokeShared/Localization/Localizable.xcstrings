    "Double tap to play. Swipe up or down for playback and library actions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen zum Abspielen. Nach oben oder unten wischen für Wiedergabe- und Mediathek-Aktionen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksoisnapauta toistaaksesi. Pyyhkäise ylös tai alas toisto- ja kirjastotoimintoja varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour lire. Balayez vers le haut ou le bas pour les actions de lecture et de bibliothèque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップで再生。上下にスワイプすると再生とライブラリの操作ができます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двічі торкніться, щоб відтворити. Проведіть угору чи вниз для дій відтворення та медіатеки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点两下以播放。向上或向下轻扫可执行播放和资料库操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點兩下以播放。向上或向下滑動可執行播放和資料庫操作。"
          }
        }
      }
    },
    "Double tap to point the Digital Crown here. Swipe up or down to seek by 15 seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doppeltippen, um die Digital Crown hierauf zu richten. Nach oben oder unten wischen, um 15 Sekunden zu springen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaksoisnapauta ohjataksesi Digital Crownin tähän. Pyyhkäise ylös tai alas siirtyäksesi 15 sekuntia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour diriger la Digital Crown ici. Balayez vers le haut ou le bas pour avancer ou reculer de 15 secondes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップするとDigital Crownの操作対象をここにします。上下にスワイプすると15秒ずつ移動します。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двічі торкніться, щоб спрямувати Digital Crown сюди. Проведіть угору чи вниз, щоб перемотати на 15 секунд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点两下可将数码表冠指向此处。向上或向下轻扫可快进或快退 15 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點兩下可將數位錶冠指向此處。向上或向下滑動可快轉或倒轉 15 秒。"
          }
        }
      }
    },
