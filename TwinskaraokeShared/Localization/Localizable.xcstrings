    "That code timed out for security. Get a new one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Code ist aus Sicherheitsgründen abgelaufen. Hol dir einen neuen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koodi vanheni turvallisuussyistä. Hae uusi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce code a expiré par sécurité. Obtenez-en un nouveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコードはセキュリティのため期限切れになりました。新しいコードを取得してください。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Термін дії коду минув з міркувань безпеки. Отримайте новий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代码已因安全原因过期。请获取新代码。"
