    "Play a playlist or song list to fill the queue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele eine Playlist oder Songliste ab, um die Warteschlange zu füllen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toista soittolista tai kappalelista täyttääksesi jonon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancez une playlist ou une liste de titres pour remplir la file d’attente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレイリストか曲リストを再生するとキューが埋まります。"
