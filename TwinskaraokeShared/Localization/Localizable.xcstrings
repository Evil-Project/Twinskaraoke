        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此代碼已因安全原因過期。請取得新代碼。"
          }
        }
      }
    },
    "That username or password isn’t correct." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benutzername oder Passwort ist nicht korrekt."
          }
        },
        "fi" : {
