      }
    },
    "The camera couldn't be opened. Check that it isn't blocked by another app, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kamera konnte nicht geöffnet werden. Prüfe, ob sie von einer anderen App blockiert wird, und versuche es erneut."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kameraa ei voitu avata. Tarkista, ettei toinen sovellus estä sitä, ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir l’appareil photo. Vérifiez qu’aucune autre app ne l’utilise, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
