  "components": {
    "messages": {
      "Ping": {
        "name": "Ping",
        "title": "Ping",
        "summary": "Keepalive request.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "Ping"
            }
          }
        }
      },
      "Pong": {
        "name": "Pong",
        "title": "Pong",
        "summary": "Keepalive response.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "Pong"
            }
          }
        }
      },
      "Play": {
        "name": "Play",
        "title": "Play",
        "summary": "Resume playback.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "Play"
            }
          }
        }
      },
      "Pause": {
        "name": "Pause",
        "title": "Pause",
        "summary": "Pause playback.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "Pause"
            }
          }
        }
      },
      "Seek": {
        "name": "Seek",
        "title": "Seek",
        "summary": "Seek within the current song.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "Seek"
            },
            "payload": {
              "type": "number",
              "description": "Position in seconds."
            }
          }
        },
        "examples": [
          {
            "payload": {
              "type": "Seek",
              "payload": 42.5
            }
          }
        ]
      },
      "SkipNext": {
        "name": "SkipNext",
        "title": "SkipNext",
        "summary": "Advance to the next song in the queue.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "SkipNext"
            }
          }
        }
      },
      "SkipPrevious": {
        "name": "SkipPrevious",
        "title": "SkipPrevious",
        "summary": "Restart the current song, or move to the previous song if playback is near the start.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "SkipPrevious"
            }
          }
        }
      },
      "PlaySongAt": {
        "name": "PlaySongAt",
        "title": "PlaySongAt",
        "summary": "Start playback at a specific queue item.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "PlaySongAt"
            },
            "payload": {
              "description": "Queue item reference: a `queueItemId` (or `songId`) string, or an object containing either field.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "queueItemId": {
                      "type": "string"
                    },
                    "songId": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "ReportPosition": {
        "name": "ReportPosition",
        "title": "ReportPosition",
        "summary": "Host playback heartbeat, sent every few seconds to keep listeners synchronized.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "ReportPosition"
            },
            "payload": {
              "type": "object",
              "properties": {
                "positionSeconds": {
                  "type": "number"
                },
                "isPlaying": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "examples": [
          {
            "payload": {
              "type": "ReportPosition",
              "payload": {
                "positionSeconds": 61.2,
                "isPlaying": true
              }
            }
          }
        ]
      },
      "AddSong": {
        "name": "AddSong",
        "title": "AddSong",
        "summary": "Appends a song to the queue. Ignored if the song is already queued, unless duplicates are allowed.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "AddSong"
            },
            "payload": {
              "type": "object",
              "description": "Queue item. `queueItemId` and `addedBy` are assigned by the server.",
              "required": [
                "songId"
              ],
              "properties": {
                "queueItemId": {
                  "type": "string"
                },
                "songId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "artists": {
                  "type": "string"
                },
                "audioUrl": {
                  "type": "string"
                },
                "hlsUrl": {
                  "type": "string"
                },
                "coverUrl": {
                  "type": "string"
                },
                "duration": {
                  "type": "number",
                  "description": "Duration in seconds."
                },
                "addedBy": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "RemoveSong": {
        "name": "RemoveSong",
        "title": "RemoveSong",
        "summary": "Removes a song from the queue.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "RemoveSong"
            },
            "payload": {
              "description": "Queue item reference: a `queueItemId` (or `songId`) string, or an object containing either field.",
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "queueItemId": {
                      "type": "string"
                    },
                    "songId": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "ReorderQueue": {
        "name": "ReorderQueue",
        "title": "ReorderQueue",
        "summary": "Moves a queue item to a new position.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "ReorderQueue"
            },
            "payload": {
              "type": "object",
              "properties": {
                "queueItemId": {
                  "type": "string"
                },
                "songId": {
                  "type": "string"
                },
                "newOrder": {
                  "type": "integer",
                  "description": "Zero-based target index."
                }
              },
              "required": [
                "newOrder"
              ]
            }
          }
        },
        "examples": [
          {
            "payload": {
              "type": "ReorderQueue",
              "payload": {
                "queueItemId": "q_123",
                "newOrder": 0
              }
            }
          }
        ]
      },
      "ShuffleQueue": {
        "name": "ShuffleQueue",
        "title": "ShuffleQueue",
        "summary": "Shuffles the remaining queue items.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "ShuffleQueue"
            }
          }
        }
      },
      "SetRepeatMode": {
        "name": "SetRepeatMode",
        "title": "SetRepeatMode",
        "summary": "Sets the repeat mode.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "SetRepeatMode"
            },
            "payload": {
              "type": "string",
              "description": "Possible values: `Off`, `All`, `One`"
            }
          }
        }
      },
      "ListenerAddSong": {
        "name": "ListenerAddSong",
        "title": "ListenerAddSong",
        "summary": "AddSong variant for listeners. Requires the room's listener-add permission and is subject to the room's cooldown.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "ListenerAddSong"
            },
            "payload": {
              "type": "object",
              "description": "Queue item. `queueItemId` and `addedBy` are assigned by the server.",
              "required": [
                "songId"
              ],
              "properties": {
                "queueItemId": {
                  "type": "string"
                },
                "songId": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "artists": {
                  "type": "string"
                },
                "audioUrl": {
                  "type": "string"
                },
                "hlsUrl": {
                  "type": "string"
                },
                "coverUrl": {
                  "type": "string"
                },
                "duration": {
                  "type": "number",
                  "description": "Duration in seconds."
                },
                "addedBy": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "SendMessage": {
        "name": "SendMessage",
        "title": "SendMessage",
        "summary": "Sends a chat message (max 500 characters). The payload is either a string or an object with `content` and an optional `replyToId`.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "SendMessage"
            },
            "payload": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "replyToId": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        },
        "examples": [
          {
            "payload": {
              "type": "SendMessage",
              "payload": {
                "content": "this song slaps",
                "replyToId": null
              }
            }
          }
        ]
      },
      "KickUser": {
        "name": "KickUser",
        "title": "KickUser",
        "summary": "Removes a user from the room.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "KickUser"
            },
            "payload": {
              "type": "string",
              "description": "Target user ID."
            }
          }
        }
      },
      "CloseRoom": {
        "name": "CloseRoom",
        "title": "CloseRoom",
        "summary": "Closes the room and disconnects all users.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "CloseRoom"
            }
          }
        }
      },
      "RoomState": {
        "name": "RoomState",
        "title": "RoomState",
        "summary": "Full room snapshot, sent once immediately after connecting.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "RoomState"
            },
            "payload": {
              "type": "object",
              "properties": {
                "room": {
                  "type": "object",
                  "description": "Same structure as the items returned by `GET /rooms/public`."
                },
                "queue": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "description": "Queue item. `queueItemId` and `addedBy` are assigned by the server.",
                    "required": [
                      "songId"
                    ],
                    "properties": {
                      "queueItemId": {
                        "type": "string"
                      },
                      "songId": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "artists": {
                        "type": "string"
                      },
                      "audioUrl": {
                        "type": "string"
                      },
                      "hlsUrl": {
                        "type": "string"
                      },
                      "coverUrl": {
                        "type": "string"
                      },
                      "duration": {
                        "type": "number",
                        "description": "Duration in seconds."
                      },
                      "addedBy": {
                        "type": "string"
                      }
                    }
                  }
                },
                "listeners": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "userId": {
                        "type": "string"
                      },
                      "displayName": {
                        "type": "string"
                      },
                      "avatarUrl": {
                        "type": "string"
                      },
                      "frameTheme": {
                        "type": "integer"
                      },
                      "level": {
                        "type": "integer"
                      },
                      "isHost": {
                        "type": "boolean"
                      },
                      "isCoHost": {
                        "type": "boolean"
                      }
                    }
                  }
                },
                "nowPlaying": {
                  "type": "object",
                  "properties": {
                    "queueItemId": {
                      "type": "string"
                    },
                    "songId": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "artists": {
                      "type": "string"
                    },
                    "audioUrl": {
                      "type": "string"
                    },
                    "hlsUrl": {
                      "type": "string"
                    },
                    "coverUrl": {
                      "type": "string"
                    },
                    "positionSeconds": {
                      "type": "number"
                    },
                    "durationSeconds": {
                      "type": "number"
                    },
                    "isPlaying": {
                      "type": "boolean"
                    },
                    "serverTimestampMs": {
                      "type": "integer",
                      "description": "Server time (Unix ms) when the snapshot was taken. Add the elapsed time to `positionSeconds` to get the current position."
                    }
                  }
                },
                "repeatMode": {
                  "type": "string",
                  "description": "Possible values: `Off`, `All`, `One`"
                }
              }
            }
          }
        }
      },
      "PlaybackSync": {
        "name": "PlaybackSync",
        "title": "PlaybackSync",
        "summary": "Current song and playback position. Sent after every playback change and periodically during playback.",
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "const": "PlaybackSync"
            },
            "payload": {
              "type": "object",
              "properties": {
                "queueItemId": {
                  "type": "string"
                },
                "songId": {
                  "type": "string"
                },
                "title": {
