        "$ref": "#/channels/room"
      },
      "title": "Control playback",
      "summary": "Restricted to the host and co-hosts. Each change is followed by a PlaybackSync broadcast.",
      "messages": [
        {
          "$ref": "#/channels/room/messages/Play"
        },
        {
          "$ref": "#/channels/room/messages/Pause"
        },
        {
          "$ref": "#/channels/room/messages/Seek"
        },
