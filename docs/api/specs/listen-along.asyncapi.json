        },
        "ShuffleQueue": {
          "$ref": "#/components/messages/ShuffleQueue"
        },
        "SetRepeatMode": {
          "$ref": "#/components/messages/SetRepeatMode"
        },
        "ListenerAddSong": {
          "$ref": "#/components/messages/ListenerAddSong"
        },
        "SendMessage": {
          "$ref": "#/components/messages/SendMessage"
        },
        "KickUser": {
          "$ref": "#/components/messages/KickUser"
        },
        "CloseRoom": {
          "$ref": "#/components/messages/CloseRoom"
        },
        "Pong": {
          "$ref": "#/components/messages/Pong"
        },
        "RoomState": {
          "$ref": "#/components/messages/RoomState"
        },
        "PlaybackSync": {
          "$ref": "#/components/messages/PlaybackSync"
        },
        "QueueUpdated": {
          "$ref": "#/components/messages/QueueUpdated"
        },
        "RepeatModeChanged": {
