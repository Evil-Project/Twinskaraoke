        },
        "PlaySongAt": {
          "$ref": "#/components/messages/PlaySongAt"
        },
        "ReportPosition": {
          "$ref": "#/components/messages/ReportPosition"
        },
        "AddSong": {
          "$ref": "#/components/messages/AddSong"
        },
        "RemoveSong": {
          "$ref": "#/components/messages/RemoveSong"
        },
        "ReorderQueue": {
